{
  "name": "inkwash-site",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:admin": "pnpm --filter inkwash-admin dev",
    "dev:web": "pnpm --filter inkwash-web dev",
    "build:admin": "pnpm --filter inkwash-admin build",
    "build:web": "pnpm --filter inkwash-web build",
    "build:share": "pnpm --filter @inkwash/share build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "clean": "pnpm -r --filter './packages/**' rimraf node_modules dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.0.0"
}
